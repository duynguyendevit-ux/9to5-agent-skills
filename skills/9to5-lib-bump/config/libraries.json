{
  "_comment": "Illustrative registry. Replace with verified local checkout and artifact coordinates.",
  "libraries": {
    "COMMON_CORE_VERSION": {
      "repo": "~/workspace/common-core",
      "artifact": "org.example:common-core",
      "note": "example shared library"
    }
  },
  "not_local": [
    "KAFKA_STARTER_VERSION"
  ],
  "debug_flags": {
    "DEBUG_COMMON_CORE": "COMMON_CORE_VERSION"
  },
  "build": {
    "java_home": "~/.jdks/jdk-17",
    "verify": "./gradlew build",
    "fast_check": "./gradlew compileJava"
  },
  "commit_convention": {
    "preferred": "update <lib> to <version>",
    "rule": "match the target repository"
  }
}
