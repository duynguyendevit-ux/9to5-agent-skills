{
  "_comment": "Illustrative roots. Inventory your real working checkouts before changing dependencies.",
  "include_roots": [
    "~/workspace/services",
    "~/workspace/common"
  ],
  "exclude_paths": [
    "~/workspace/mirrors"
  ],
  "exclude_name_patterns": [
    "/build/",
    "/node_modules/",
    "/.git/",
    "/.gradle/"
  ],
  "known_duplicate_checkouts": []
}
