{
  "_comment": "Illustrative configuration only. Populate from your own read-only cluster inventory before use.",
  "kubectl_bin": "kubectl",
  "kubeconfig": "~/.kube/config",
  "helpers_script": "~/workspace/k8slog/rancher-log-alias.sh",
  "default_context": "example-dev-context",
  "contexts": [
    "example-dev-context"
  ],
  "environments": {
    "example-dev": {
      "namespace": "example-dev",
      "project": "example-platform"
    },
    "example-device": {
      "namespace": "example-device",
      "project": "example-device"
    }
  },
  "non_app_namespaces": [
    "default",
    "kube-system"
  ],
  "not_covered": {
    "uat_prod": "Unverified: check your own kubeconfig; examples do not establish access."
  }
}
