# Working state, never committed
cache.json
**/cache.json

# Local-only internal endpoints (real hostnames; ship the .example.json instead)
skills/*/config/endpoints.json
skills/*/config/public-export.local.json

# Python
__pycache__/
*.pyc
.venv/

# Investigation artifacts (durable conclusions belong in notes/)
skills/*/debug/artifacts/*
!skills/*/debug/artifacts/.gitkeep

# Editors / OS
.DS_Store
.idea/
*.swp

# Private request-specific memory and release evidence belong to a working repo.
.kit/memory/
.kit/releases/
